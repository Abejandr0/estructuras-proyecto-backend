# MongoDB Atlas connection string for production, or local Docker service.
MONGODB_URI=mongodb://aiverse:replace-this-password@127.0.0.1:27017/aiverse?authSource=admin

# Set to your deployed Vercel origin in Render (no trailing slash).
WEB_ORIGIN=http://localhost:5173

# Configure these on the backend only. Keep the key out of Vercel and source control.
AI_ALLOW_NETWORK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used only when building the web Docker image locally. On Vercel set VITE_API_URL.
VITE_API_URL=http://localhost:4179

# Used by docker-compose for the local MongoDB container.
MONGO_PASSWORD=replace-with-a-long-random-password
